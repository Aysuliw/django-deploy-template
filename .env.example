# Copy to .env on the server (chmod 600). Never commit .env.
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me

# Optional. Errors go to Sentry and/or a Telegram chat.
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
